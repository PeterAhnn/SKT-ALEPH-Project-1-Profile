{
  "name": "skt-aleph-project-1-profile-passkey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-source.mjs",
    "build": "npm run check && node scripts/build.mjs",
    "bra:update": "node tools/bra/apply.mjs",
    "bra:test": "node --test tools/bra/*.test.mjs",
    "bra:verify": "node tools/bra/verify.mjs --input tools/bra/input --reference tools/bra/last-result --report verification/bra/reproducibility.json",
    "brb:preview": "node tools/brb/serve.mjs",
    "brb:test": "node --test tools/brb/*.test.mjs",
    "brb:verify-paper": "node tools/brb/verify-paper.mjs",
    "brb:package": "python tools/brb/package.py"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "pg": "8.23.1"
  },
  "devDependencies": { "playwright": "1.64.1" }
}
